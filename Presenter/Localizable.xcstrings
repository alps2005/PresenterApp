    "Background cleared for now. Slides with their own background bring one back. To remove it for good, use the slide's Background button." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondo quitado por ahora. Las diapositivas con fondo propio lo vuelven a poner. Para quitarlo del todo, usa el botón Fondo de la diapositiva."
          }
        }
      }
    },
