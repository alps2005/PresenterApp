    "%@ · %lld of %lld over the slide. Next steps through the verses." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$lld of %3$lld over the slide. Next steps through the verses."
