{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "“%@” is removed from the library and from every show. You can undo this with ⌘Z. If it's live, it stays on the audience output until you take something else live." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se quita de la biblioteca y de todos los programas. Puedes deshacerlo con ⌘Z. Si está en vivo, sigue en la salida al público hasta que pongas otra cosa en vivo."
          }
        }
      }
    },
    "(deleted)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(eliminado)"
          }
        }
      }
    },
    "%@ – used by the %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ – used by the %2$@"
