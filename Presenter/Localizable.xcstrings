    "Presenter is dark unless you choose otherwise, so it stays quiet in a dark room." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenter es oscuro salvo que elijas otra cosa, para que no moleste en una sala a oscuras."
          }
        }
      }
    },
    "Presenter is running from the disk image, so it can't update itself. Quit, drag Presenter onto the Applications shortcut, eject the disk image and open Presenter from Applications." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenter se está ejecutando desde la imagen de disco, así que no puede actualizarse. Sal, arrastra Presenter al acceso directo de Aplicaciones, expulsa la imagen de disco y abre Presenter desde Aplicaciones."
          }
        }
      }
    },
