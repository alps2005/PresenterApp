    "%@ If you quit now, changes since the last save are lost. To keep them, cancel and use Export Project… to save a copy somewhere else." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Si sales ahora, se pierden los cambios desde la última vez que se guardó. Para conservarlos, cancela y usa Exportar proyecto… para guardar una copia en otro lugar."
          }
        }
      }
    },
