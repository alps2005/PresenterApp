        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temas"
          }
        }
      }
    },
    "There's no timer called “%@”, so it shows nothing. Make it in the Live panel's Timers tab, or fix the name." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún temporizador llamado “%@”, así que no muestra nada. Créalo en la pestaña Temporizadores del panel En vivo o corrige el nombre."
          }
        }
      }
    },
    "Things to look at in “%@” before the service:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosas que revisar en “%@” antes del culto:"
          }
        }
      }
    },
    "This copy of Presenter doesn't update itself (a development build)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de Presenter no se actualiza sola (es una versión de desarrollo)."
          }
        }
      }
    },
    "This macro was deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta macro se eliminó."
          }
        }
      }
    },
    "This slide uses its presentation's background." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta diapositiva usa el fondo de su presentación."
          }
        }
      }
    },
    "This slide was edited after going live. Take it live again to show the changes." : {
      "localizations" : {
