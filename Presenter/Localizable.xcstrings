    "0 moves on as soon as the slide's video ends (with a video that plays once)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 0 avanza en cuanto termina el video de la diapositiva (si el video se reproduce una sola vez)."
          }
        }
      }
    },
