            "value" : "Color del texto"
          }
        }
      }
    },
    "Text follows the theme unless you format it by hand. Make or edit themes in the sidebar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto sigue el tema salvo que le des formato a mano. Crea o edita temas en la barra lateral."
          }
        }
      }
    },
    "Text formatted by hand on a slide keeps its own look. In the editor, Revert to Theme makes it follow the theme again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto con formato a mano en una diapositiva conserva su aspecto. En el editor, Volver al tema hace que siga el tema otra vez."
          }
        }
      }
    },
    "Text formatted by hand on any slide follows the theme again" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto con formato a mano en cualquier diapositiva vuelve a seguir el tema"
          }
        }
      }
    },
    "Text on the yellow bar" : {
      "localizations" : {
        "es" : {
